# Base URL the browser calls. Leave as /api so both dev (vite proxy) and prod
# (reverse proxy) work without code changes.
VITE_API_BASE_URL=/api

# DEV ONLY: where the vite proxy forwards /api during `npm run dev`.
# Set this to your reachable API. Copy this file to .env.local and edit.
VITE_DEV_API_TARGET=http://172.16.20.89:8000
